+/** Increase branching and serial length separately while retaining real compiler port types. */
+object NativeScaleXYBenchmark {
+  val layouts = Vector((4, 0), (5, 0), (4, 4), (4, 8))
+
+  def main(args: Array[String]): Unit =
+    CompiledXYBenchmark.run(args, layouts.map { case (groups, filters) =>
+      val name = s"groups-$groups-filters-$filters"
+      (name, name, () => {
+        val compiled = NativeBranchXYFixtures.compileScale(groups, groups, filters)
+        require(compiled.input.plan.operators.size == 4 + 2 * groups * (4 + filters))
+        require(compiled.original.getBlockingAndDependeeLinks.size == 4 * groups)
+        compiled
+      })
+    }, exhaustiveLimit = 8)
+}
