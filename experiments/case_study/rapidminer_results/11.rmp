2798264641, &quot;Y&quot;: 2.916666666666668, &quot;Class&quot;: &quot;12&quot;}, {&quot;X&quot;: 7.6572668112798254, &quot;Y&quot;: 4.458333333333332, &quot;Class&quot;: &quot;13&quot;}, {&quot;X&quot;: 8.221258134490238, &quot;Y&quot;: 0.08333333333333215, &quot;Class&quot;: &quot;13&quot;}, {&quot;X&quot;: 2.97180043383948, &quot;Y&quot;: -5.041666666666666, &quot;Class&quot;: &quot;13&quot;}, {&quot;X&quot;: -0.6290672451193053, &quot;Y&quot;: -4.375, &quot;Class&quot;: &quot;13&quot;}, {&quot;X&quot;: -10.303687635574837, &quot;Y&quot;: -2.0, &quot;Class&quot;: &quot;13&quot;}, {&quot;X&quot;: -9.82646420824295, &quot;Y&quot;: 3.958333333333332, &quot;Class&quot;: &quot;13&quot;}, {&quot;X&quot;: 6.225596529284164, &quot;Y&quot;: 8.25, &quot;Class&quot;: &quot;14&quot;}, {&quot;X&quot;: 6.832971800433839, &quot;Y&quot;: 7.791666666666664, &quot;Class&quot;: &quot;14&quot;}, {&quot;X&quot;: 5.661605206073752, &quot;Y&quot;: 4.625, &quot;Class&quot;: &quot;14&quot;}, {&quot;X&quot;: 6.529284164859, &quot;Y&quot;: 4.833333333333334, &quot;Class&quot;: &quot;14&quot;}, {&quot;X&quot;: 5.2277657266811275, &quot;Y&quot;: 6.291666666666668, &quot;Class&quot;: &quot;14&quot;}, {&quot;X&quot;: -3.969631236442517, &quot;Y&quot;: 7.75, &quot;Class&quot;: &quot;17&quot;}, {&quot;X&quot;: -4.620390455531453, &quot;Y&quot;: 5.166666666666666, &quot;Class&quot;: &quot;17&quot;}, {&quot;X&quot;: -3.5791757049891535, &quot;Y&quot;: 3.875, &quot;Class&quot;: &quot;17&quot;}, {&quot;X&quot;: -1.453362255965292, &quot;Y&quot;: 0.125, &quot;Class&quot;: &quot;17&quot;}, {&quot;X&quot;: -0.455531453362255, &quot;Y&quot;: -2.958333333333333, &quot;Class&quot;: &quot;17&quot;}]''')&#10;def batches = rows.groupBy { it.Class }.collect { key, group -&gt; [group: key, rows: group] }&#10;operator.process.macroHandler.addMacro('batches', batches.size().toString())&#10;return table(batches)" />
        <parameter key="standard_imports" value="false" />
      </operator>
      <operator class="loop" compatibility="10.1.000" name="Repeat" activated="true" expanded="true" x="245" y="35">
        <parameter key="set_iteration_macro" value="true" />
        <parameter key="macro_name" value="i" />
        <parameter key="macro_start_value" value="0" />
        <parameter key="iterations" value="%{batches}" />
        <process>
          <operator class="execute_script" compatibility="10.1.000" name="Body" activated="true" expanded="true" x="180" y="60">
            <parameter key="script" value="&#10;import com.rapidminer.example.table.AttributeFactory&#10;import com.rapidminer.example.table.DoubleArrayDataRow&#10;import com.rapidminer.example.table.MemoryExampleTable&#10;import com.rapidminer.tools.Ontology&#10;import groovy.json.JsonOutput&#10;import groovy.json.JsonSlurper&#10;def table(rows) {&#10;    def col = AttributeFactory.createAttribute(&quot;payload&quot;, Ontology.STRING)&#10;    def t = new MemoryExampleTable([col])&#10;    for (row in rows) {&#10;        double value = col.mapping.mapString(JsonOutput.toJson(row))&#10;        t.addDataRow(new DoubleArrayDataRow([value] as double[]))&#10;    }&#10;    return t.createExampleSet()&#10;}&#10;def unpack(set) {&#10;    def col = set.attributes.get(&quot;payload&quot;)&#10;    return set.collect { new JsonSlurper().parseText(it.getValueAsString(col)) }&#10;}&#10;int i = Integer.parseInt(operator.process.macroHandler.getMacro('i'))&#10;def batch = unpack(input[0])[i]&#10;&#10;def stats(rows, name, group) {&#10;    def cells = rows.collect { it[name] }&#10;    def values = cells.findAll { it != null &amp;&amp; Double.isFinite(it.doubleValue()) }&#10;    int n = values.size()&#10;    double sum = values.sum(), mean = sum / n&#10;    def moment = { power -&gt; values.sum { Math.pow(it.doubleValue() - mean, power) } }&#10;    double variance = moment(2) / (n-1), sd = Math.sqrt(variance)&#10;    def nan = [__float__: 'NaN']&#10;    return [Column: name, Min: values.min(), Max: values.max(), Mean: mean,&#10;      'Std. deviation': sd, Variance: variance,&#10;      Skewness: n &lt; 3 ? nan : n * moment(3) / ((n-1)*(n-2)*Math.pow(sd,3)),&#10;      Kurtosis: n &lt; 4 ? nan : n*(n+1)*moment(4)/((n-1)*(n-2)*(n-3)*Math.pow(sd,4))&#10;        - 3d*(n-1)*(n-1)/((n-2)*(n-3)),&#10;      'Overall sum': sum, 'No. missings': cells.count { it == null },&#10;      'No. NaNs': cells.count { it != null &amp;&amp; Double.isNaN(it.doubleValue()) },&#10;      'No. +∞s': cells.count { it == Double.POSITIVE_INFINITY },&#10;      'No. -∞s': cells.count { it == Double.NEGATIVE_INFINITY },&#10;      Median: null, 'Row count': cells.size(), Class: group]&#10;}&#10;def result = table(['X','Y'].collect { name -&gt; stats(batch.rows, name, batch.group) })&#10;return result" />
            <parameter key="standard_imports" value="false" />
          </operator>
          <connect from_port="input 1" to_port="input 1" to_op="Body" />
          <connect from_port="output 1" to_port="output 1" from_op="Body" />
        </process>
      </operator>
      <operator class="execute_script" compatibility="10.1.000" name="Collect" activated="true" expanded="true" x="445" y="35">
        <parameter key="script" value="&#10;import com.rapidminer.example.table.AttributeFactory&#10;import com.rapidminer.example.table.DoubleArrayDataRow&#10;import com.rapidminer.example.table.MemoryExampleTable&#10;import com.rapidminer.tools.Ontology&#10;import groovy.json.JsonOutput&#10;import groovy.json.JsonSlurper&#10;def table(rows) {&#10;    def col = AttributeFactory.createAttribute(&quot;payload&quot;, Ontology.STRING)&#10;    def t = new MemoryExampleTable([col])&#10;    for (row in rows) {&#10;        double value = col.mapping.mapString(JsonOutput.toJson(row))&#10;        t.addDataRow(new DoubleArrayDataRow([value] as double[]))&#10;    }&#10;    return t.createExampleSet()&#10;}&#10;def unpack(set) {&#10;    def col = set.attributes.get(&quot;payload&quot;)&#10;    return set.collect { new JsonSlurper().parseText(it.getValueAsString(col)) }&#10;}&#10;def rows = input[0].getObjects().collectMany { unpack(it) }&#10;return table(rows)" />
        <parameter key="standard_imports" value="false" />
      </operator>
      <connect from_port="output 1" to_port="input 1" from_op="Prepare" to_op="Repeat" />
      <connect from_port="output 1" to_port="input 1" from_op="Repeat" to_op="Collect" />
      <connect from_port="output 1" to_port="result 1" from_op="Collect" />
    </process>
  </operator>
</process>