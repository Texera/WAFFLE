      <operator class="execute_script" compatibility="10.1.000" name="Prepare" activated="true" expanded="true" x="45" y="35">
        <parameter key="script" value="&#10;import com.rapidminer.example.table.AttributeFactory&#10;import com.rapidminer.example.table.DoubleArrayDataRow&#10;import com.rapidminer.example.table.MemoryExampleTable&#10;import com.rapidminer.tools.Ontology&#10;import groovy.json.JsonOutput&#10;import groovy.json.JsonSlurper&#10;def table(rows) {&#10;    def col = AttributeFactory.createAttribute(&quot;payload&quot;, Ontology.STRING)&#10;    def t = new MemoryExampleTable([col])&#10;    for (row in rows) {&#10;        double value = col.mapping.mapString(JsonOutput.toJson(row))&#10;        t.addDataRow(new DoubleArrayDataRow([value] as double[]))&#10;    }&#10;    return t.createExampleSet()&#10;}&#10;def unpack(set) {&#10;    def col = set.attributes.get(&quot;payload&quot;)&#10;    return set.collect { new JsonSlurper().parseText(it.getValueAsString(col)) }&#10;}&#10;def rows = new JsonSlurper().parseText('''[{&quot;X&quot;: -5.140997830802603, &quot;Y&quot;: 3.916666666666666, &quot;Class&quot;: &quot;3&quot;}, {&quot;X&quot;: -3.969631236442517, &quot;Y&quot;: -1.291666666666666, &quot;Class&quot;: &quot;3&quot;}, {&quot;X&quot;: 3.665943600867678, &quot;Y&quot;: 3.5, &quot;Class&quot;: &quot;3&quot;}, {&quot;X&quot;: 5.488069414316703, &quot;Y&quot;: -4.5, &quot;Class&quot;: &quot;3&quot;}, {&quot;X&quot;: 5.271149674620389, &quot;Y&quot;: 3.083333333333334, &quot;Class&quot;: &quot;2&quot;}, {&quot;X&quot;: 2.3644251626898054, &quot;Y&quot;: 6.708333333333336, &quot;Class&quot;: &quot;2&quot;}, {&quot;X&quot;: 2.10412147505423, &quot;Y&quot;: 5.333333333333334, &quot;Class&quot;: &quot;2&quot;}, {&quot;X&quot;: -2.0173535791757047, &quot;Y&quot;: 3.333333333333332, &quot;Class&quot;: &quot;2&quot;}, {&quot;X&quot;: -2.407809110629068, &quot;Y&quot;: 0.7916666666666661, &quot;Class&quot;: &quot;2&quot;}, {&quot;X&quot;: 3.0151843817787416, &quot;Y&quot;: -1.0, &quot;Class&quot;: &quot;2&quot;}, {&quot;X&quot;: 2.2342733188720167, &quot;Y&quot;: -3.375, &quot;Clas