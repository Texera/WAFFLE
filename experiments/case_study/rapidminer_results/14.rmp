<?xml version='1.0' encoding='utf-8'?>
<process version="10.1.000">
  <operator class="process" compatibility="10.1.000" name="Process" activated="true" expanded="true" x="0" y="0">
    <process>
      <operator class="execute_script" compatibility="10.1.000" name="Prepare" activated="true" expanded="true" x="45" y="35">
        <parameter key="script" value="&#10;import com.rapidminer.example.table.AttributeFactory&#10;import com.rapidminer.example.table.DoubleArrayDataRow&#10;import com.rapidminer.example.table.MemoryExampleTable&#10;import com.rapidminer.tools.Ontology&#10;import groovy.json.JsonOutput&#10;import groovy.json.JsonSlurper&#10;def table(rows) {&#10;    def col = AttributeFactory.createAttribute(&quot;payload&quot;, Ontology.STRING)&#10;    def t = new MemoryExampleTable([col])&#10;    for (row in rows) {&#10;        double value = col.mapping.mapString(JsonOutput.toJson(row))&#10;        t.addDataRow(new DoubleArrayDataRow([value] as double[]))&#10;    }&#10;    return t.createExampleSet()&#10;}&#10;def unpack(set) {&#10;    def col = set.attributes.get(&quot;payload&quot;)&#10;    return set.collect { new JsonSlurper().parseText(it.getValueAsString(col)) }&#10;}&#10;def rows = new JsonSlurper().parseText('''[{&quot;X&quot;: -5.44468546637744, &quot;Y&quot;: 4.708333333333334, &quot;Class&quot;: &quot;1&quot;}, {&quot;X&quot;: -5.2277657266811275, &quot;Y&quot;: -4.208333333333333, &quot;Class&quot;: &quot;1&quot;}, {&quot;X&quot;: -2.6681127982646426, &quot;Y&quot;: 2.333333333333334, &quot;Class&quot;: &quot;1&quot;}, {&quot;X&quot;: -5.835140997830803, &quot;Y&quot;: 2.125, &quot;Class&quot;: &quot;1&quot;}, {&quot;X&quot;: -4.360086767895879, &quot;Y&quot;: -1.833333333333334, &quot;Class&quot;: &quot;1&quot;}, {&quot;X&quot;: -4.924078091106291, &quot;Y&quot;: -2.333333333333333, &quot;Class&quot;: &quot;1&quot;}, {&quot;X&quot;: -6.876355748373102, &quot;Y&quot;: -1.0, &quot;Class&quot;: &quot;1&quot;}, {&quot;X&quot;: -7.049891540130152, &quot;Y&quot;: -2.583333333333333, &quot;Class&quot;: &quot;1&quot;}, {&quot;X&quot;: -4.707158351409978, &quot;Y&quot;: -5.416666666666667, &quot;Class&quot;: &quot;1&quot;}, {&quot;X&quot;: -3.752711496746204, &quot;Y&quot;: -2.25, &quot;Class&quot;: &quot;1&quot;}, {&quot;X&quot;: -5.010845986984815, &quot;Y&quot;: 2.833333333333334, &quot;Class&quot;: &quot;1&quot;}, {&quot;X&quot;: -5.054229934924078, &quot;Y&quot;: 3.791666666666666, &quot;Class&quot;: &quot;1&quot;}, {&quot;X&quot;: -7.18004338394794, &quot;Y&quot;: 3.083333333333334, &quot;Class&quot;: &quot;1&quot;}, {&quot;X&quot;: -3.405639913232104, &quot;Y&quot;: 0.041666666666666075, &quot;Class&quot;: &quot;1&quot;}, {&quot;X&quot;: 5.574837310195228, &quot;Y&quot;: 3.166666666666666, &quot;Class&quot;: &quot;2&quot;}, {&quot;X&quot;: 4.3167028199566175, &quot;Y&quot;: 2.333333333333334, &quot;Class&quot;: &quot;2&quot;}, {&quot;X&quot;: 8.958785249457701, &quot;Y&quot;: 4.916666666666668, &quot;Class&quot;: &quot;2&quot;}, {&quot;X&quot;: 4.099783080260304, &quot;Y&quot;: 8.125, &quot;Class&quot;: &quot;2&quot;}, {&quot;X&quot;: 5.661605206073752, &quot;Y&quot;: 5.416666666666668, &quot;Class&quot;: &quot;2&quot;}, {&quot;X&quot;: 7.396963123644252, &quot;Y&quot;: 5.208333333333332, &quot;Class&quot;: &quot;2&quot;}, {&quot;X&quot;: 2.10412147505423, &quot;Y&quot;: 4.958333333333334, &quot;Class&quot;: &quot;2&quot;}, {&quot;X&quot;: 4.70715835140998, &quot;Y&quot;: 5.5, &quot;Class&quot;: &quot;2&quot;}, {&quot;X&quot;: 5.097613882863341, &quot;Y&quot;: 3.416666666666666, &quot;Class&quot;: &quot;2&quot;}, {&quot;X&quot;: 6.225596529284164, &quot;Y&quot;: -5.041666666666666, &quot;Class&quot;: &quot;2&quot;}, {&quot;X&quot;: 2.711496746203906, &quot;Y&quot;: -3.75, &quot;Class&quot;: &quot;2&quot;}, {&quot;X&quot;: 4.143167028199565, &quot;Y&quot;: -2.125, &quot;Class&quot;: &quot;2&quot;}, {&quot;X&quot;: 5.748373101952279, &quot;Y&quot;: -2.0, &quot;Class&quot;: &quot;2&quot;}, {&quot;X&quot;: 3.405639913232104, &quot;Y&quot;: -4.666666666666667, &quot;Class&quot;: &quot;2&quot;}, {&quot;X&quot;: 6.182212581344903, &quot;Y&quot;: -3.958333333333334, &quot;Class&quot;: &quot;2&quot;}, {&quot;X&quot;: 4.663774403470715, &quot;Y&quot;: -3.416666666666667, &quot;Class&quot;: &quot;2&quot;}, {&quot;X&quot;: 6.399132321041215, &quot;Y&quot;: -2.5, &quot;Class&quot;: &quot;2&quot;}, {&quot;X&quot;: 8.394793926247289, &quot;Y&quot;: -2.208333333333333, &quot;Class&quot;: &quot;2&quot;}, {&quot;X&quot;: 3.3622559652928423, &quot;Y&quot;: -1.458333333333334, &quot;Class&quot;: &quot;2&quot;}, {&quot;X&quot;: 3.665943600867678, &quot;Y&quot;: -3.833333333333333, &quot;Class&quot;: &quot;2&quot;}, {&quot;X&quot;: 5.704989154013017, &quot;Y&quot;: -4.791666666666666, &quot;Class&quot;: &quot;2&quot;}]''')&#10;def batches = (0..4).collect { [rows: rows, value: it * 0.25d] }&#10;operator.process.macroHandler.addMacro('batches', batches.size().toString())&#10;return table(batches)" />
        <parameter key="standard_imports" value="false" />
      </operator>
      <operator class="loop" compatibility="10.1.000" name="Repeat" activated="true" expanded="true" x="245" y="35">
        <parameter key="set_iteration_macro" value="true" />
        <parameter key="macro_name" value="i" />
        <parameter key="macro_start_value" value="0" />
        <parameter key="iterations" value="%{batches}" />
        <process>
          <operator class="execute_script" compatibility="10.1.000" name="Body" activated="true" expanded="true" x="180" y="60">
            <parameter key="script" value="&#10;import com.rapidminer.example.table.AttributeFactory&#10;import com.rapidminer.example.table.DoubleArrayDataRow&#10;import com.rapidminer.example.table.MemoryExampleTable&#10;import com.rapidminer.tools.Ontology&#10;import groovy.json.JsonOutput&#10;import groovy.json.JsonSlurper&#10;def table(rows) {&#10;    def col = AttributeFactory.createAttribute(&quot;payload&quot;, Ontology.STRING)&#10;    def t = new MemoryExampleTable([col])&#10;    for (row in rows) {&#10;        double value = col.mapping.mapString(JsonOutput.toJson(row))&#10;        t.addDataRow(new DoubleArrayDataRow([value] as double[]))&#10;    }&#10;    return t.createExampleSet()&#10;}&#10;def unpack(set) {&#10;    def col = set.attributes.get(&quot;payload&quot;)&#10;    return set.collect { new JsonSlurper().parseText(it.getValueAsString(col)) }&#10;}&#10;int i = Integer.parseInt(operator.process.macroHandler.getMacro('i'))&#10;def batch = unpack(input[0])[i]&#10;def result = table(batch.rows.collect { row -&gt;&#10;    double x = row.X * batch.value&#10;    row + [X: x, Y: -x * batch.value]&#10;})&#10;return result" />
            <parameter key="standard_imports" value="false" />
          </operator>
          <connect from_port="input 1" to_port="input 1" to_op="Body" />
          <connect from_port="output 1" to_port="output 1" from_op="Body" />
        </process>
      </operator>
      <operator class="execute_script" compatibility="10.1.000" name="Collect" activated="true" expanded="true" x="445" y="35">
        <parameter key="script" value="&#10;import com.rapidminer.example.table.AttributeFactory&#10;import com.rapidminer.example.table.DoubleArrayDataRow&#10;import com.rapidminer.example.table.MemoryExampleTable&#10;import com.rapidminer.tools.Ontology&#10;import groovy.json.JsonOutput&#10;import groovy.json.JsonSlurper&#10;def table(rows) {&#10;    def col = AttributeFactory.createAttribute(&quot;payload&quot;, Ontology.STRING)&#10;    def t = new MemoryExampleTable([col])&#10;    for (row in rows) {&#10;        double value = col.mapping.mapString(JsonOutput.toJson(row))&#10;        t.addDataRow(new DoubleArrayDataRow([value] as double[]))&#10;    }&#10;    return t.createExampleSet()&#10;}&#10;def unpack(set) {&#10;    def col = set.attributes.get(&quot;payload&quot;)&#10;    return set.collect { new JsonSlurper().parseText(it.getValueAsString(col)) }&#10;}&#10;def rows = input[0].getObjects().collectMany { unpack(it) }&#10;return table(rows)" />
        <parameter key="standard_imports" value="false" />
      </operator>
      <connect from_port="output 1" to_port="input 1" from_op="Prepare" to_op="Repeat" />
      <connect from_port="output 1" to_port="input 1" from_op="Repeat" to_op="Collect" />
      <connect from_port="output 1" to_port="result 1" from_op="Collect" />
    </process>
  </operator>
</process>