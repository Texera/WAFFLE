    {
      "id": "Input",
      "name": "Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "const rows = [{\"Text\": \"A\"}, {\"Text\": \"A\"}, {\"Text\": \"A\"}, {\"Text\": \"A\"}, {\"Text\": \"A\"}, {\"Text\": \"A\"}, {\"Text\": \"A\"}, {\"Text\": \"A\"}, {\"Text\": \"A\"}, {\"Text\": \"A\"}];\nconst batches = [];\nfor (let offset = 0; offset < rows.length; offset += 3)\n  batches.push({rows: rows.slice(offset, offset + 3), i: batches.length});\nreturn batches;"
      }
    },
    {
      "id": "Body",
      "name": "Body",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        120
      ],
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst counts = new Map();\nfor (const row of input.rows) counts.set(row.Text, (counts.get(row.Text) || 0) + 1);\nreturn [{rows: [...counts].map(([value, count]) => ({value, count, Iteration: input.i}))}];"
      }
    },
    {
      "id": "Loop",
      "name": "Loop",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        450,
        0
      ],
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
      "id": "Result",
      "name": "Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        -100
      ],
      "parameters": {
        "jsCode": "const rows = $input.all().flatMap(item => item.json.rows);\nreturn rows;"
      }
    }
  ],
