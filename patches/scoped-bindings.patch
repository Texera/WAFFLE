 class State(dict):
+    CHECKPOINT_V1 = "waffle-loop-checkpoint-v1"
+
+    def checkpoint(self, assigned_names):
+        # This record is private to the loop back edge. User keys in either
+        # map are unrestricted. Older checkpoints contained just the values.
+        assigned = {k: v for k, v in self.items() if k in assigned_names}
+        candidates = {k: v for k, v in self.items() if k not in assigned_names}
+        return State(assigned=assigned, candidates=candidates).to_tuple(message_id=self.CHECKPOINT_V1)
+
+    @classmethod
+    def read_checkpoint(cls, row):
+        values = cls.from_tuple(row)
+        if row[cls.MESSAGE_ID] == cls.CHECKPOINT_V1:
+            return values["assigned"], values["candidates"]
+        return values, {}
+
